# Copy to .env and fill in the platforms you want. Each platform is optional —
# leave a block empty and it's simply skipped during sync.
# Load it before running:  set -a; source .env; set +a   (or use python-dotenv)

# ---- YouTube (Data API v3) --------------------------------------------------
# Create an API key at https://console.cloud.google.com/ (enable "YouTube Data
# API v3"). Find your channel ID at https://www.youtube.com/account_advanced.
# Provides: views, likes, comments.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_MAX=30

# ---- YouTube retention (Analytics API, OAuth) — optional --------------------
# Real average-view-% retention. Create an OAuth client of type
# "TVs and Limited Input devices", then run `python auth_youtube.py` once to
# mint the refresh token. Leave blank to skip (retention stays 0).
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
# YOUTUBE_ANALYTICS_START=2024-01-01   # default: 730 days ago

# ---- Instagram (Graph API) --------------------------------------------------
# Requires a Business/Creator account linked to a Facebook Page + a long-lived
# access token, and your IG user id. Guide:
# https://developers.facebook.com/docs/instagram-platform
# Provides: plays/reach, likes, comments, saves, shares.
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_API_VERSION=v21.0
IG_MAX=30

# ---- TikTok (Display API) ---------------------------------------------------
# Requires an approved app + a user OAuth access token with video.list scope.
# Guide: https://developers.tiktok.com/doc/display-api-get-started
# Provides: views, likes, comments, shares.
TIKTOK_ACCESS_TOKEN=
TIKTOK_MAX=30

# ---- Idea Engine (optional AI) ----------------------------------------------
# The Idea Engine works with zero keys (data-driven). Add an Anthropic API key
# to get sharper, Claude-generated ideas. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ---- Automation -------------------------------------------------------------
# Run a full sync (your channels + competitors) automatically every N minutes.
# 0 / unset = manual only (use the "Sync now" button). e.g. 60 = hourly.
SYNC_INTERVAL_MINUTES=0
# How many recent posts to pull per competitor channel.
COMPETITOR_MAX=20

# ---- Storage ----------------------------------------------------------------
# DB_PATH=data.db
# Path to your live channel config (own brand + competitors). See channels.example.json.
# CHANNELS_CONFIG=channels.json
